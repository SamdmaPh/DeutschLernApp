import {
  View, Text, TouchableOpacity, ScrollView, StyleSheet,
  StatusBar, Platform, Animated, TextInput, KeyboardAvoidingView, Pressable
} from "react-native";
import { useState, useRef, useEffect, useCallback } from "react";
import { useRouter } from "expo-router";
import { useFocusEffect } from "@react-navigation/native";
import { Audio } from "expo-av";
import { Progress } from "../services/progress";
import { C, SAFE_TOP, SAFE_BOTTOM, SERIF } from "../theme";

const BACKEND = "https://deutschlernappbackend2-production.up.railway.app";

function FlagStrip() {
  return (
    <View style={{ flexDirection: "row", height: 3 }}>
      <View style={{ flex: 1, backgroundColor: C.flagBlack }} />
      <View style={{ flex: 1, backgroundColor: C.flagRed }} />
      <View style={{ flex: 1, backgroundColor: C.flagGold }} />
    </View>
  );
}

const TOPICS = [
  { id: "cafe",    emoji: "☕", label: "Im Café",       color: C.gold,   prompt: "Du bist im Café. Hilf dem Lernenden beim Bestellen und Small Talk." },
  { id: "arbeit",  emoji: "💼", label: "Arbeit",         color: C.red,    prompt: "Büro-Gespräch. Kollegen, Meetings, Aufgaben." },
  { id: "reise",   emoji: "✈️", label: "Reisen",         color: C.blue,   prompt: "Reisegespräch. Bahnhof, Hotel, Ausflüge." },
  { id: "essen",   emoji: "🍽", label: "Essen",          color: C.green,  prompt: "Restaurant oder Kochen. Bestellungen, Rezepte, Geschmack." },
  { id: "freizeit",emoji: "🎭", label: "Freizeit",       color: C.purple, prompt: "Hobbys, Sport, Kultur, Wochenende." },
  { id: "frei",    emoji: "🌐", label: "Freies Gespräch",color: C.muted,  prompt: "Freies Gespräch. Folge dem Lernenden." },
];

interface Message { id: string; role: "user"|"assistant"; content: string; }

export default function ConversationScreen() {
  const router = useRouter();
  const [topic,      setTopic]      = useState<typeof TOPICS[0] | null>(null);
  const [messages,   setMessages]   = useState<Message[]>([]);
  const [input,      setInput]      = useState("");
  const [loading,    setLoading]    = useState(false);
  const [mode,       setMode]       = useState<"text"|"voice">("text");
  const [isRecording,setIsRecording]= useState(false);
  const [micError,   setMicError]   = useState<string|null>(null);
  const [userLevel,  setUserLevel]  = useState("A1");
  const [sound,      setSound]      = useState<Audio.Sound|null>(null);
  const [playingId,  setPlayingId]  = useState<string|null>(null);

  const scrollRef  = useRef<ScrollView>(null);
  const inputRef   = useRef<any>(null);
  const recordRef  = useRef<Audio.Recording|null>(null);
  const pulseAnim  = useRef(new Animated.Value(1)).current;
  const pulseLoop  = useRef<Animated.CompositeAnimation|null>(null);
  const fadeAnim   = useRef(new Animated.Value(0)).current;

  useFocusEffect(useCallback(() => {
    Progress.getStudyLevel().then(l => {
      const map: Record<string,string> = { beginner:"A1", some:"A1", intermediate:"A2" };
      setUserLevel(map[l] || l || "A1");
    });
    Animated.timing(fadeAnim, { toValue: 1, duration: 400, useNativeDriver: true }).start();
    return () => {
      sound?.unloadAsync();
      recordRef.current?.stopAndUnloadAsync();
    };
  }, []));

  async function selectTopic(t: typeof TOPICS[0]) {
    setTopic(t);
    setLoading(true);
    try {
      const res = await fetch(`${BACKEND}/api/conversation`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          messages: [],
          topic: `${t.prompt} Level: ${userLevel}. Starte das Gespräch mit einem kurzen, einladenden Satz auf Deutsch.`,
          level: userLevel,
        }),
      });
      const raw = await res.text();
      let data: any = {};
      try { data = JSON.parse(raw); } catch {}
      const reply = data.text || data.reply || "Hallo! Wie kann ich helfen?";
      setMessages([{ id: Date.now().toString(), role: "assistant", content: reply }]);
    } catch {
      setMessages([{ id: "1", role: "assistant", content: "Hallo! Lass uns üben." }]);
    } finally { setLoading(false); }
  }

  async function sendText() {
    const text = input.trim();
    if (!text || loading) return;
    const newMsg: Message = { id: Date.now().toString(), role: "user", content: text };
    const updated = [...messages, newMsg];
    setMessages(updated);
    setInput("");
    setLoading(true);
    setTimeout(() => scrollRef.current?.scrollToEnd({ animated: true }), 100);
    try {
      const res = await fetch(`${BACKEND}/api/conversation`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          messages: updated.map(m => ({ role: m.role, content: m.content })),
          topic: topic?.prompt || "Free conversation",
          level: userLevel,
        }),
      });
      const raw = await res.text();
      let data: any = {};
      try { data = JSON.parse(raw); } catch {}
      const reply = data.text || data.reply || "...";
      setMessages(m => [...m, { id: (Date.now()+1).toString(), role: "assistant", content: reply }]);
      setTimeout(() => scrollRef.current?.scrollToEnd({ animated: true }), 100);
    } catch {} finally { setLoading(false); }
  }

  async function startRecording() {
    try {
      setMicError(null);
      const { granted } = await Audio.requestPermissionsAsync();
      if (!granted) { setMicError("Mikrofon-Zugriff verweigert"); return; }
      if (sound) { await sound.stopAsync().catch(()=>{}); await sound.unloadAsync().catch(()=>{}); setSound(null); }
      await Audio.setAudioModeAsync({ allowsRecordingIOS: false, playsInSilentModeIOS: true });
      await new Promise(r => setTimeout(r, 80));
      await Audio.setAudioModeAsync({ allowsRecordingIOS: true, playsInSilentModeIOS: true });
      const { recording } = await Audio.Recording.createAsync(Audio.RecordingOptionsPresets.HIGH_QUALITY);
      recordRef.current = recording;
      setIsRecording(true);
      pulseLoop.current = Animated.loop(Animated.sequence([
        Animated.timing(pulseAnim, { toValue: 1.15, duration: 600, useNativeDriver: true }),
        Animated.timing(pulseAnim, { toValue: 1,    duration: 600, useNativeDriver: true }),
      ]));
      pulseLoop.current.start();
    } catch (err: any) {
      setMicError("Mikrofon nicht verfügbar. App neu starten.");
    }
  }

  async function stopRecording() {
    if (!recordRef.current) return;
    pulseLoop.current?.stop(); pulseAnim.setValue(1);
    setIsRecording(false);
    setLoading(true);
    try {
      await recordRef.current.stopAndUnloadAsync();
      await Audio.setAudioModeAsync({ allowsRecordingIOS: false, playsInSilentModeIOS: true });
      const uri = recordRef.current.getURI();
      recordRef.current = null;
      if (!uri) { setLoading(false); return; }
      const blob = await fetch(uri).then(r => r.blob());
      const base64: string = await new Promise((res, rej) => {
        const reader = new FileReader();
        reader.onloadend = () => res((reader.result as string).split(",")[1]);
        reader.onerror = rej;
        reader.readAsDataURL(blob);
      });
      const apiRes = await fetch(`${BACKEND}/api/audio-conversation`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          audio: base64,
          messages: messages.map(m => ({ role: m.role, content: m.content })),
          level: userLevel,
        }),
      });
      const raw = await apiRes.text();
      let data: any = {};
      try { data = JSON.parse(raw); } catch { setMicError("Server nicht erreichbar."); setLoading(false); return; }
      if (data.error) { setMicError(data.error); setLoading(false); return; }
      const updated = [...messages,
        { id: Date.now().toString(),   role: "user" as const, content: data.userText || "…" },
        { id: (Date.now()+1).toString(), role: "assistant" as const, content: data.assistantText || "…" },
      ];
      setMessages(updated);
      if (data.audio) playBase64Audio(data.audio);
      setTimeout(() => scrollRef.current?.scrollToEnd({ animated: true }), 100);
    } catch { setMicError("Fehler beim Verarbeiten."); }
    finally { setLoading(false); }
  }

  async function playBase64Audio(base64: string, msgId?: string) {
    try {
      if (sound) { await sound.stopAsync().catch(()=>{}); await sound.unloadAsync().catch(()=>{}); setSound(null); }
      if (msgId) setPlayingId(msgId);
      await Audio.setAudioModeAsync({ playsInSilentModeIOS: true, allowsRecordingIOS: false });
      const { sound: ns } = await Audio.Sound.createAsync(
        { uri: `data:audio/mp4;base64,${base64}` }, { shouldPlay: true }
      );
      setSound(ns);
      ns.setOnPlaybackStatusUpdate(st => {
        if (st.isLoaded && st.didJustFinish) { ns.unloadAsync(); setSound(null); setPlayingId(null); }
      });
    } catch {}
  }

  async function playTTS(text: string, msgId: string) {
    if (playingId === msgId && sound) {
      await sound.stopAsync().catch(()=>{}); await sound.unloadAsync().catch(()=>{});
      setSound(null); setPlayingId(null); return;
    }
    setPlayingId(msgId);
    try {
      const res = await fetch(`${BACKEND}/api/speak`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text }),
      });
      const raw = await res.text();
      let data: any = {};
      try { data = JSON.parse(raw); } catch { setPlayingId(null); return; }
      if (data.audio) await playBase64Audio(data.audio, msgId);
      else setPlayingId(null);
    } catch { setPlayingId(null); }
  }

  // ── TOPIC SELECTION ──
  if (!topic) return (
    <View style={{ flex: 1, backgroundColor: C.bg }}>
      <StatusBar barStyle="light-content" />
      <View style={{ height: SAFE_TOP }} />
      <FlagStrip />
      <Animated.View style={{ flex: 1, opacity: fadeAnim }}>
        <View style={s.topicHeader}>
          <TouchableOpacity onPress={() => router.back()} hitSlop={12} activeOpacity={0.7}>
            <Text style={s.back}>‹</Text>
          </TouchableOpacity>
          <Text style={s.topicTitle}>KI-Gespräch</Text>
          <View style={{ width: 44 }} />
        </View>
        <View style={s.topicIntro}>
          <Text style={s.topicIntroTitle}>Worüber sprichst du heute?</Text>
          <Text style={s.topicIntroSub}>Level: {userLevel}</Text>
        </View>
        <ScrollView contentContainerStyle={s.topicGrid} showsVerticalScrollIndicator={false}>
          {TOPICS.map(t => (
            <TouchableOpacity
              key={t.id}
              style={[s.topicCard, { borderColor: `${t.color}40` }]}
              onPress={() => selectTopic(t)}
              activeOpacity={0.8}
            >
              <Text style={s.topicEmoji}>{t.emoji}</Text>
              <Text style={[s.topicLabel, { color: t.color }]}>{t.label}</Text>
            </TouchableOpacity>
          ))}
        </ScrollView>
      </Animated.View>
    </View>
  );

  // ── CHAT ──
  return (
    <KeyboardAvoidingView style={{ flex: 1, backgroundColor: C.bg }} behavior={Platform.OS === "ios" ? "padding" : "height"}>
      <StatusBar barStyle="light-content" />
      <View style={{ height: SAFE_TOP }} />
      <FlagStrip />

      {/* Header */}
      <View style={s.chatHeader}>
        <TouchableOpacity onPress={() => { setTopic(null); setMessages([]); }} hitSlop={12} activeOpacity={0.7}>
          <Text style={s.back}>‹</Text>
        </TouchableOpacity>
        <View style={s.chatHeaderCenter}>
          <Text style={s.chatTopic}>{topic.emoji}  {topic.label}</Text>
          <Text style={s.chatLevel}>{userLevel}</Text>
        </View>
        {/* Mode toggle */}
        <TouchableOpacity
          style={[s.modeToggle, mode === "voice" && { borderColor: C.redLine, backgroundColor: C.redDim }]}
          onPress={() => setMode(m => m === "text" ? "voice" : "text")}
          activeOpacity={0.8}
        >
          <Text style={[s.modeToggleText, mode === "voice" && { color: C.red }]}>
            {mode === "text" ? "🎙" : "⌨️"}
          </Text>
        </TouchableOpacity>
      </View>

      {/* Messages */}
      <ScrollView
        ref={scrollRef}
        style={{ flex: 1 }}
        contentContainerStyle={s.messagesContent}
        showsVerticalScrollIndicator={false}
      >
        {messages.map(m => (
          <View key={m.id} style={[s.bubble, m.role === "user" ? s.bubbleUser : s.bubbleAI]}>
            <Text style={[s.bubbleText, m.role === "user" && { color: C.white }]}>
              {m.content}
            </Text>
            {m.role === "assistant" && (
              <TouchableOpacity
                onPress={() => playTTS(m.content, m.id)}
                style={s.playBtn}
                activeOpacity={0.7}
              >
                <Text style={[s.playBtnText, playingId === m.id && { color: C.gold }]}>
                  {playingId === m.id ? "⏹" : "🔊"}
                </Text>
              </TouchableOpacity>
            )}
          </View>
        ))}
        {loading && (
          <View style={[s.bubble, s.bubbleAI]}>
            <Text style={[s.bubbleText, { color: C.muted }]}>…</Text>
          </View>
        )}
        {micError && (
          <View style={s.errorCard}>
            <Text style={s.errorText}>⚠️ {micError}</Text>
            <TouchableOpacity onPress={() => setMicError(null)}>
              <Text style={{ color: C.red, fontSize: 12, marginTop: 4 }}>Schließen</Text>
            </TouchableOpacity>
          </View>
        )}
      </ScrollView>

      {/* Text Input */}
      {mode === "text" && (
        <View style={s.textBar}>
          <TextInput
            ref={inputRef}
            style={s.textInput}
            value={input}
            onChangeText={setInput}
            placeholder="Schreib auf Deutsch…"
            placeholderTextColor={C.muted}
            returnKeyType="send"
            onSubmitEditing={sendText}
            editable={!loading}
            autoCapitalize="none"
          />
          <TouchableOpacity
            style={[s.sendBtn, (!input.trim() || loading) && { opacity: 0.35 }]}
            onPress={sendText}
            disabled={!input.trim() || loading}
            activeOpacity={0.8}
          >
            <Text style={s.sendIcon}>↗</Text>
          </TouchableOpacity>
        </View>
      )}

      {/* Voice Input */}
      {mode === "voice" && (
        <View style={s.voiceBar}>
          <Text style={s.voiceHint}>
            {isRecording ? "🔴 Loslassen zum Senden" : "Gedrückt halten und sprechen"}
          </Text>
          <Pressable
            style={s.micWrap}
            onPressIn={startRecording}
            onPressOut={stopRecording}
          >
            <Animated.View style={[s.micBtn, { transform: [{ scale: pulseAnim }] },
              isRecording && { backgroundColor: C.red, borderColor: C.red }
            ]}>
              <Text style={s.micIcon}>{isRecording ? "🔴" : "🎙"}</Text>
            </Animated.View>
          </Pressable>
        </View>
      )}
    </KeyboardAvoidingView>
  );
}

const s = StyleSheet.create({
  back:            { color: C.gold, fontSize: 28, fontWeight: "300", lineHeight: 34 },

  // Topic select
  topicHeader:     { flexDirection: "row", alignItems: "center", justifyContent: "space-between",
                      paddingHorizontal: 20, paddingVertical: 12 },
  topicTitle:      { fontFamily: SERIF, fontSize: 18, fontWeight: "700", color: C.white, fontStyle: "italic" },
  topicIntro:      { paddingHorizontal: 20, paddingBottom: 20 },
  topicIntroTitle: { fontFamily: SERIF, fontSize: 22, fontWeight: "700", color: C.white,
                      fontStyle: "italic", marginBottom: 4 },
  topicIntroSub:   { fontSize: 12, color: C.muted },
  topicGrid:       { paddingHorizontal: 20, flexDirection: "row", flexWrap: "wrap", gap: 10, paddingBottom: 40 },
  topicCard:       { width: "47%", backgroundColor: C.card, borderRadius: 16, borderWidth: 1,
                      padding: 20, alignItems: "center", gap: 8 },
  topicEmoji:      { fontSize: 28 },
  topicLabel:      { fontSize: 14, fontWeight: "700", textAlign: "center" },

  // Chat
  chatHeader:       { flexDirection: "row", alignItems: "center", justifyContent: "space-between",
                       paddingHorizontal: 20, paddingVertical: 12 },
  chatHeaderCenter: { alignItems: "center", flex: 1 },
  chatTopic:        { fontSize: 15, fontWeight: "700", color: C.white },
  chatLevel:        { fontSize: 11, color: C.muted, marginTop: 1 },
  modeToggle:       { width: 38, height: 38, borderRadius: 10, borderWidth: 1, borderColor: C.border,
                       backgroundColor: C.card2, alignItems: "center", justifyContent: "center" },
  modeToggleText:   { fontSize: 16, color: C.muted },

  messagesContent:  { padding: 16, paddingBottom: 8 },
  bubble:           { borderRadius: 18, padding: 14, marginBottom: 10, maxWidth: "84%" },
  bubbleAI:         { backgroundColor: C.card2, borderWidth: 1, borderColor: C.border,
                       alignSelf: "flex-start", borderBottomLeftRadius: 4 },
  bubbleUser:       { backgroundColor: C.flagRed, alignSelf: "flex-end", borderBottomRightRadius: 4 },
  bubbleText:       { fontSize: 15, color: C.text, lineHeight: 22 },
  playBtn:          { marginTop: 8, alignSelf: "flex-start" },
  playBtnText:      { fontSize: 14, color: C.muted },

  errorCard:        { backgroundColor: C.redDim, borderRadius: 12, borderWidth: 1, borderColor: C.redLine,
                       padding: 12, margin: 4 },
  errorText:        { fontSize: 13, color: C.red, lineHeight: 18 },

  textBar:          { flexDirection: "row", gap: 10, paddingHorizontal: 16, paddingVertical: 10,
                       borderTopWidth: 1, borderTopColor: C.border, alignItems: "center",
                       paddingBottom: SAFE_BOTTOM || 10 },
  textInput:        { flex: 1, backgroundColor: C.card2, borderRadius: 14, borderWidth: 1,
                       borderColor: C.border, paddingHorizontal: 16, paddingVertical: 13,
                       fontSize: 15, color: C.white },
  sendBtn:          { width: 46, height: 46, backgroundColor: C.flagRed, borderRadius: 13,
                       alignItems: "center", justifyContent: "center" },
  sendIcon:         { color: C.white, fontSize: 20, fontWeight: "700" },

  voiceBar:         { alignItems: "center", paddingVertical: 16, paddingBottom: SAFE_BOTTOM + 8,
                       borderTopWidth: 1, borderTopColor: C.border },
  voiceHint:        { fontSize: 12, color: C.muted, marginBottom: 14 },
  micWrap:          { },
  micBtn:           { width: 72, height: 72, borderRadius: 36, backgroundColor: C.card2,
                       borderWidth: 2, borderColor: C.goldLine, alignItems: "center", justifyContent: "center" },
  micIcon:          { fontSize: 28 },
});
